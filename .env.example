# The Butterfly Algorithm — Environment Configuration

# LLM Providers: "mock" (default, zero-latency testing), "groq", "gemini", or "ollama"
BUTTERFLY_PROVIDER_A=mock
BUTTERFLY_MODEL_A=groq-llama-70b

BUTTERFLY_PROVIDER_B=mock
BUTTERFLY_MODEL_B=gemini-flash

# Cloud API Keys (optional — required only if provider is set to groq or gemini)
GROQ_API_KEY=
GEMINI_API_KEY=

# Local Ollama URL & Timeouts (optional — required only if provider is set to ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_MAX_RETRIES=2
OLLAMA_NUM_PREDICT=1408
OLLAMA_THINK=false

# Simulation Defaults
DEFAULT_MAX_ITERATIONS=3
DEFAULT_CHURN_RATE=0.08
DEFAULT_EXTERNAL_WEIGHT=0.40

# Storage Hygiene Paths (optional overrides)
# BUTTERFLY_SESSIONS_DIR=data/sessions
# BUTTERFLY_TEST_SESSIONS_DIR=data/test_sessions
# BUTTERFLY_FORECASTS_DIR=data/forecasts
# BUTTERFLY_REPORTS_DIR=data/reports
# BUTTERFLY_BACKUPS_DIR=data/backups
# BUTTERFLY_OUTPUTS_DIR=data/outputs

